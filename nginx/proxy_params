# ═══════════════════════════════════════════════════════════════════════════════
# Standard Proxy Headers
# Include this file in proxy locations for consistent header handling
# ═══════════════════════════════════════════════════════════════════════════════

# Original host
proxy_set_header Host $host;

# Real client IP (important for rate limiting and logging)
proxy_set_header X-Real-IP $remote_addr;

# Forwarded for chain
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

# Original protocol (http/https)
proxy_set_header X-Forwarded-Proto $scheme;

# Original host (alternative)
proxy_set_header X-Forwarded-Host $host;

# Original port
proxy_set_header X-Forwarded-Port $server_port;

# Connection upgrade for WebSocket support
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;

# Tenant identification (extracted from subdomain)
proxy_set_header X-Tenant-ID $tenant_id;

# Request ID for tracing (if provided by client, otherwise Nginx can generate)
# proxy_set_header X-Request-ID $request_id;
